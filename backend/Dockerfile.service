# 通用业务服务模板镜像（JDK 17 基线）
# 构建时通过 --build-arg SVC=Mod_login 指定模块（或 compose environment SVC）
FROM eclipse-temurin:17-jre
ARG SVC=gateway
ENV SVC=${SVC}
COPY ${SVC}/target/*.jar /app.jar
EXPOSE 80 8001 8002 8005 8007 8008 8009 8010
ENTRYPOINT ["java", "-Xmx512m", "-Dfile.encoding=UTF-8", "-jar", "/app.jar"]
